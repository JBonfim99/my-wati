# Copie para .env e preencha. Nunca commite o .env.

# Supabase — Postgres (Transaction pooler, porta 6543) e Auth
# Dashboard → Connect → Transaction pooler
DATABASE_URL=postgresql://<db-user>.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:6543/postgres
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# Opcional: convites por e-mail (POST /api/members) — só servidor
# SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
# Opcional: redirects de convite se Origin não existir no pedido
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo (mín. 16 caracteres, recomendado 32+) para cifrar os tokens da Meta
# Gere com: openssl rand -hex 32
APP_ENCRYPTION_KEY=<random-secret>

# Redis do BullMQ (local / Docker worker)
REDIS_URL=redis://localhost:6379

# Opcional: Traefik ACME (docker-compose)
DOMAIN=<seu-dominio.com>
ACME_EMAIL=<seu-email@exemplo.com>

# Opcional: concorrência dos workers (defaults: 3 / 1 / 1)
WORKER_CONCURRENCY=3
# BULK_WORKER_CONCURRENCY=1
# IMPORT_WORKER_CONCURRENCY=1

# Opcional: cache do GET /api/templates em segundos (default 120, mín. 30)
# WABA_TEMPLATES_CACHE_SECONDS=120

# Obrigatório para criar template com cabeçalho IMAGE: ID numérico do app
# (Meta for Developers → Configurações → Básico)
META_APP_ID=<meta-app-id>
